{
  "name": "opal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "lint": "eslint --fix --ignore-path .gitignore .",
    "format": "prettier --ignore-path .gitignore --write './**/*.{css,js,json,md}'",
    "fmt": "npm-run-all format",
    "test": "npm-run-all test:*",
    "test:lint": "eslint --ignore-path .gitignore .",
    "test:format": "prettier --ignore-path .gitignore --check './**/*.{css,js,json,md}'",
    "build": "next build",
    "start": "next start",
    "export": "next export",
    "deploy": "npm-run-all build export"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm-run-all lint format"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.13.7",
    "@mui/material": "^5.13.7",
    "@mui/styles": "^6.1.2",
    "clsx": "^1.1.1",
    "dotenv": "^16.0.3",
    "isomorphic-unfetch": "^3.1.0",
    "next": "^14.2.14",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-countdown": "^2.3.0",
    "react-dom": "^18.2.0",
    "react-player": "^2.10.0",
    "react-scroll": "^1.8.7",
    "react-slick": "^0.29.0",
    "react-slugify": "^2.1.0",
    "slick-carousel": "^1.8.1",
    "webpack": "^5.70.0"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^8.10.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8"
  }
